# Canonical production site URL (no trailing slash)
PUBLIC_SITE_URL=https://textfixer.com

# Public contact address used on /contact (mailto)
PUBLIC_CONTACT_EMAIL=hello@textfixer.com

# Optional Search Console / Bing verification tokens (meta tags)
# PUBLIC_GOOGLE_SITE_VERIFICATION=
# PUBLIC_BING_SITE_VERIFICATION=

# Analytics (anonymous product events only — never send user text)
# PUBLIC_ANALYTICS_ENABLED=false
# PUBLIC_ANALYTICS_ENDPOINT=
