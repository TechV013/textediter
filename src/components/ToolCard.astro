---
import type { ToolDefinition } from '../lib/tools/types';
import { getCategoryLabel } from '../lib/tools/registry';

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
---

<a
  href={`/${tool.slug}`}
  class="panel group flex h-full flex-col transition-all duration-200 hover:border-accent/60 hover:shadow-[0_0_20px_rgba(34,211,238,0.15)] hover:-translate-y-1"
>
  <div class="flex items-start justify-between gap-2 mb-3">
    <span class="text-xl text-accent/80 group-hover:text-accent font-mono" aria-hidden="true">&gt;_</span>
    <span class="chip">{getCategoryLabel(tool.category)}</span>
  </div>
  <span class="text-lg font-semibold text-ink group-hover:text-accent transition-colors">{tool.name}</span>
  <span class="mt-2 text-sm text-muted leading-relaxed flex-1">{tool.shortDescription}</span>

  <!-- Technical metadata badges -->
  <div class="flex items-center gap-2 mt-4 pt-3 border-t border-border/50">
    <span class="text-[9px] font-bold uppercase tracking-wider text-muted/70 font-mono">Local</span>
    <span class="text-[9px] text-muted/40">•</span>
    <span class="text-[9px] font-bold uppercase tracking-wider text-muted/70 font-mono">Instant</span>
  </div>
</a>
