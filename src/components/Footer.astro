---
import { SITE_NAME, SITE_TAGLINE } from '../lib/seo/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border bg-surface/95">
  <div class="container-page grid gap-8 py-10 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="text-lg font-bold tracking-tight">{SITE_NAME}</p>
      <p class="mt-2 max-w-md text-sm text-muted">{SITE_TAGLINE}</p>
      <p class="mt-3 text-sm text-muted">
        Processing for normal tools happens in your browser. We don’t require an account.
      </p>
    </div>
    <div>
      <p class="text-sm font-semibold">Product</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a class="hover:text-accent" href="/#tools">All tools</a></li>
        <li><a class="hover:text-accent" href="/text-cleaner">Text Cleaner</a></li>
        <li><a class="hover:text-accent" href="/word-counter">Word Counter</a></li>
        <li><a class="hover:text-accent" href="/email-extractor">Email Extractor</a></li>
        <li><a class="hover:text-accent" href="/about">About</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold">Legal</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a class="hover:text-accent" href="/privacy">Privacy</a></li>
        <li><a class="hover:text-accent" href="/terms">Terms</a></li>
        <li><a class="hover:text-accent" href="/contact">Contact</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-border">
    <div class="container-page flex flex-col gap-2 py-4 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE_NAME}. All rights reserved.</p>
      <p>Built for speed, privacy, and clarity.</p>
    </div>
  </div>
</footer>
