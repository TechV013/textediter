---
interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
  class?: string;
}

const { faqs, class: className = '' } = Astro.props;
---

<section class:list={['max-w-3xl', className]} aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-2xl font-semibold tracking-tight">FAQ</h2>
  <div class="mt-4 divide-y divide-border rounded-2xl border border-border bg-surface">
    {
      faqs.map((faq) => (
        <details class="group p-4">
          <summary class="cursor-pointer list-none font-medium marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-start justify-between gap-3">
              {faq.question}
              <span class="text-muted transition group-open:rotate-45" aria-hidden="true">+</span>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted">{faq.answer}</p>
        </details>
      ))
    }
  </div>
</section>
