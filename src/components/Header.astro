---
import { SITE_NAME } from '../lib/seo/site';
---

<header class="border-b border-border bg-surface/95 backdrop-blur-md sticky top-0 z-40">
  <div class="container-page flex h-14 items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-2 no-underline">
      <span class="text-xl font-extrabold text-accent group-hover:brightness-110 tracking-tighter font-mono" aria-hidden="true">
        &gt;_
      </span>
      <span class="text-base font-bold tracking-widest text-ink group-hover:text-accent transition-colors">{SITE_NAME}</span>
    </a>

    <nav class="flex items-center gap-1 sm:gap-2" aria-label="Primary">
      <a href="/#tools" class="btn-ghost hidden sm:inline-flex">Tools</a>
      <a href="/about" class="btn-ghost hidden md:inline-flex">About</a>
      <button type="button" class="btn-ghost min-w-11" data-theme-toggle aria-pressed="false" aria-label="Toggle color theme">
        <span class="dark:hidden" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"></path>
          </svg>
        </span>
        <span class="hidden dark:inline" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
        </span>
      </button>
    </nav>
  </div>
</header>
